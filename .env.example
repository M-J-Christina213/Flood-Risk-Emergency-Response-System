# Set in your shell before starting the corresponding process. No secrets here.
FLOOD_DB_PATH=.demo/submission.db
FLOOD_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
FLOOD_MAX_AGE_SECONDS=21600
FLOOD_ALERT_COOLDOWN_SECONDS=3600
FLOOD_DELIVERY_ADAPTER=test
# Optional real Expo transport token; leave unset for default test delivery.
# EXPO_ACCESS_TOKEN=
VITE_API_BASE_URL=http://127.0.0.1:8000
EXPO_PUBLIC_API_BASE_URL=http://YOUR_COMPUTER_LAN_IP:8000
